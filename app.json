{
  "expo": {
    "name": "Kaarya",
    "slug": "kaarya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/kaarya-icon-noalpha.png",
    "scheme": "kaarya",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aroramrinaal.kaarya",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icons/kaarya-icon-noalpha.png",
      "requireFullScreen": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/kaarya-icon-noalpha.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "modular_headers": true,
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5ebd937-b801-4bc9-a2bc-8c186bc8a873"
      }
    },
    "android": {
      "package": "com.aroramrinaal.kaarya"
    }
  }
}
